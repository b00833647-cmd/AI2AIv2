# ─── AI2AI environment template ──────────────────────────────────────────
# Copy to .env (which is git-ignored) and fill in.
# In production: set these in your hosting platform's secret manager
# (Railway / Fly / Render env vars), NOT in a .env file in the image.

# ─── Required ────────────────────────────────────────────────────────────

# Single-key mode: one Anthropic key for buyer agent + seller agent + orchestrator.
# OR set the three per-side keys below for true API-key isolation between agents
# (the value of either pattern is the same for the participant — pick one).
ANTHROPIC_API_KEY=

# Per-side mode (recommended for research isolation, not strictly required):
BUYER_ANTHROPIC_API_KEY=
SELLER_ANTHROPIC_API_KEY=
ORCHESTRATOR_ANTHROPIC_API_KEY=

# Reproducible condition assignment (clean experimental design). REQUIRED.
# Any fixed non-empty string; changing it changes the assignment sequence.
AI2AI_ASSIGNMENT_SEED=change-me-to-a-fixed-study-seed

# ─── Strongly recommended ────────────────────────────────────────────────

# Password protecting /admin and /api/p/erase. If unset, those endpoints
# return 503 — only data collection works, no dashboard / right-to-erasure.
AI2AI_ADMIN_PASSWORD=

# Daily LLM-spend cap (USD). When today's estimated cost exceeds this,
# /api/p/run returns 503 "budget_exceeded" until midnight UTC. If unset,
# no cost cap. ~$0.40 per completed participant at Sonnet 4.6 prices.
AI2AI_DAILY_BUDGET_USD=20

# Persistent path for SQLite. In Docker / cloud deploys, point at a mounted
# volume so participant data survives container restarts. Defaults to
# ./data/sessions.db (fine for local dev).
AI2AI_DB_PATH=./data/sessions.db

# ─── Optional ────────────────────────────────────────────────────────────

# Server port. Default 3737. Cloud platforms usually inject PORT — read it
# in your start command if needed (e.g. AI2AI_PORT=$PORT npx tsx ...).
AI2AI_PORT=3737

# Disable the per-IP rate limit on /api/p/start (default: 1 attempt per IP
# per 24h). Set to 'off' for lab pilots over a single shared IP.
# AI2AI_RATE_LIMIT=off
