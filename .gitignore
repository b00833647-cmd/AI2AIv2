# Dependencies
node_modules/

# Secrets — never commit
.env
.env.local
.env.*.local

# Local databases (participant data lives here in dev)
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# Generated runtime artifacts.
# pack.json is regenerated per session and contains free-text participant
# content — never commit it.
scenarios/toyota-camry-negotiation/pack.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Build output (we don't currently build, kept for safety)
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Local backup directories created during development
AI2AI-backup-*/

# Claude Code internal state (intelligence cache, sessions etc.)
.claude-flow/
.claude/*.lock
.claude/local/

# Git worktrees (isolated dev workspaces — never commit their contents)
.worktrees/

# Python bytecode caches
__pycache__/
*.pyc

# Report build cache (regeneratable parquet)
docs/reports/cache-grand/

# Confirmatory report output. The test suite invokes report.py, which writes
# synthetic DRY-RUN tables here — they must never land next to the real
# published tables in docs/reports/tables-grand/. Force-add (git add -f) if you
# ever want to commit a genuine confirmatory run.
docs/reports/tables-confirmatory/

# Environment / secrets — NEVER commit (.env.example is the only allowed template)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.backup*
*.env.backup*
.env.local.backup
